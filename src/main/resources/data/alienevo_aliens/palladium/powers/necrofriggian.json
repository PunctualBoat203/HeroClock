      "title": "necrofriggian",
      "icon": "alienevo:textures/gui/playlists/playlist_1/alien_5.png",
      "hidden": false,
      "first_tick_commands": [
        "scale set pehkui:hitbox_height 1.2",
        "scale set pehkui:eye_height 1.25",
        "tag @s add afomni.freeze_immunity"
      ],
      "last_tick_commands": [
        "scale set pehkui:hitbox_height 1",
        "scale set pehkui:eye_height 1",
        "tag @s remove afomni.freeze_immunity"
      ],
      "commands": [
        "execute if entity @e[tag=a.iceberg,distance=..128,limit=1] as @e[tag=a.iceberg,distance=..128] at @s run function afomni:iceberg/projectile_tick",
        "execute if entity @a[scores={afomni.use_iceberg=1..},limit=1] as @a[scores={afomni.use_iceberg=1..}] at @s run function afomni:iceberg/tick",
        "execute if entity @e[type=armor_stand,tag=IceSpikes,distance=..128,limit=1] run scoreboard players add @e[type=armor_stand,tag=IceSpikes,distance=..128] afomni.IceSpikesStart 1",
        "execute if entity @e[type=armor_stand,scores={afomni.IceSpikesStart=100..},distance=..128,limit=1] as @e[type=armor_stand,scores={afomni.IceSpikesStart=100..},distance=..128] run kill @s",
        "execute if entity @e[tag=IceSpikeRay,distance=..128,limit=1] run function afomni:aliens/necrofriggian/ice_spike_raycast",
        "execute if entity @e[type=armor_stand,tag=ice_spike,distance=..128,limit=1] run function afomni:aliens/necrofriggian/ice_spikes"
      ]
    },
