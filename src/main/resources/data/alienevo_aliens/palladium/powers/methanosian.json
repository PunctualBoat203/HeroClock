        "execute as @e[tag=a.tree,distance=..128] at @s run function afomni:tree/projectile_tick",
        "execute as @e[tag=a.branch,distance=..128] at @s run function afomni:tree/branch_tick",
        "execute as @e[tag=a.root,distance=..128] at @s run function afomni:tree/root_tick",
        "execute as @a[scores={afomni.use_tree=1..}] at @s run function afomni:tree/tick",
        "scoreboard players add @e[type=armor_stand,tag=DiamondSpikes,distance=..128] AlienEvo.SpikesStart 1",
        "execute as @e[scores={AlienEvo.SpikesStart=100..},type=armor_stand,distance=..128] run kill @s",
        "function afomni:aliens/petrosapien/diamond_spike_raycast",
        "function afomni:aliens/petrosapien/diamond_spike",
